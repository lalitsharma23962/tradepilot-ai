# Server-only secure vault configuration. Never expose these as VITE_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRADEPILOT_VAULT_KEY=
TRADEPILOT_VAULT_ADMIN_TOKEN=

# Generate a 32-byte AES-256 key locally:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Generate a strong vault admin token locally:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Exchange API keys must be created with withdrawal permission disabled.
